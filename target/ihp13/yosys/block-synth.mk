# Description:
# Standalone synthesis of one hw/coproc block (minutes, not hours): used for
# the rounds-per-cycle sweep and by the CI `synth-coproc` check. It reuses the
# chip flow's own synthesis script (scripts/yosys_synthesis.tcl), ABC scripts,
# target period and SG13G2 liberty, so block numbers are comparable with the
# block's instance in the full-SoC run. The block is converted with sv2v (as
# the chip flow's pickle does) through a generated wrapper that fixes the
# block's parameters, then timed with OpenSTA against an 11.0 ns clock on
# clk_i (the SoC's clk_sys period, target/ihp13/openroad/src/basilisk.sdc)
# with zero I/O delay.
#
#   make synth-coproc-block BLOCK=keccak_cvxif ROUNDS_PER_CYCLE=2
#
# Outputs under target/ihp13/yosys/block/<BLOCK>_r<R>/: netlist, yosys
# reports, sta.rpt and metrics.json; the make target fails if yosys `check`
# reports a problem.

BLOCK            ?= keccak_cvxif
ROUNDS_PER_CYCLE ?= 1
BLOCK_PERIOD_NS  ?= 11.0

BLOCK_NAME   := $(BLOCK)_r$(ROUNDS_PER_CYCLE)
BLOCK_DIR    := $(YOSYS_DIR)/block/$(BLOCK_NAME)
BLOCK_TOP    := $(BLOCK_NAME)_top
BLOCK_SV2V   := $(BLOCK_DIR)/$(BLOCK_NAME).sv2v.v
BLOCK_NET    := $(BLOCK_DIR)/$(BLOCK_NAME).yosys.v
BLOCK_WRAP   := $(BLOCK_DIR)/$(BLOCK_TOP).sv

# Same sources as the hw/coproc unit tests (hw/coproc/coproc.mk). sv2v has no
# library search, so keccak_mmio lists axi_to_detailed_mem's whole subtree.
BLOCK_SRCS_keccak_cvxif = $(COPROC_CVA6_PKGS) $(COPROC_KECCAK_SRCS) $(COPROC_CC_DIR)/src/fifo_v3.sv \
                          $(COPROC_DIR)/keccak_cvxif.sv
BLOCK_SRCS_keccak_mmio  = $(COPROC_MMIO_PKGS) $(COPROC_KECCAK_SRCS) \
                          $(addprefix $(COPROC_CC_DIR)/src/, fifo_v3.sv mem_to_banks_detailed.sv \
                            stream_fifo.sv stream_fork.sv stream_fork_dynamic.sv stream_join.sv \
                            stream_join_dynamic.sv stream_mux.sv stream_to_mem.sv) \
                          $(COPROC_AXI_DIR)/src/axi_to_detailed_mem.sv $(COPROC_DIR)/keccak_mmio.sv

# Extra sv2v defines per block. sv2v cannot parse the SVA in
# axi_to_detailed_mem's assertion block (`default disable iff`), which is
# simulation-only and guarded by `ifndef VERILATOR`; defining VERILATOR drops
# it (the chip flow's morty pass never hands it to sv2v either).
BLOCK_SV2V_DEFINES_keccak_mmio := --define=VERILATOR

# Wrapper per block: fixes the parameters and gives the block concrete port
# types. keccak_mmio gets the SoC's external-subordinate AXI types: 48-bit
# address, 64-bit data, 2-bit user and a 5-bit id (Cheshire's AxiMstIdWidth 2
# + clog2 of its 6 crossbar managers: core, debug, DMA, serial link, VGA, USB).
define BLOCK_WRAP_keccak_cvxif
// Generated by block-synth.mk: fixes $(BLOCK) parameters for synthesis.
module $(BLOCK_TOP) (
  input  logic clk_i, input logic rst_ni,
  input  cvxif_pkg::cvxif_req_t cvxif_req_i, output cvxif_pkg::cvxif_resp_t cvxif_resp_o
);
  $(BLOCK) #(.RoundsPerCycle($(ROUNDS_PER_CYCLE))) i_$(BLOCK) (
    .clk_i, .rst_ni, .cvxif_req_i, .cvxif_resp_o);
endmodule
endef

define BLOCK_WRAP_keccak_mmio
// Generated by block-synth.mk: fixes $(BLOCK) parameters for synthesis.
`include "axi/typedef.svh"
package $(BLOCK_TOP)_pkg;
  typedef logic [47:0] addr_t;
  typedef logic [63:0] data_t;
  typedef logic [7:0]  strb_t;
  typedef logic [4:0]  id_t;
  typedef logic [1:0]  user_t;
  `AXI_TYPEDEF_ALL(axi, addr_t, id_t, data_t, strb_t, user_t)
endpackage
module $(BLOCK_TOP) (
  input  logic clk_i, input logic rst_ni,
  input  $(BLOCK_TOP)_pkg::axi_req_t axi_req_i, output $(BLOCK_TOP)_pkg::axi_resp_t axi_rsp_o
);
  $(BLOCK) #(.RoundsPerCycle($(ROUNDS_PER_CYCLE)), .AddrWidth(48), .DataWidth(64), .IdWidth(5),
    .UserWidth(2), .axi_req_t($(BLOCK_TOP)_pkg::axi_req_t),
    .axi_rsp_t($(BLOCK_TOP)_pkg::axi_resp_t)) i_$(BLOCK) (
    .clk_i, .rst_ni, .axi_req_i, .axi_rsp_o);
endmodule
endef

SV2V ?= sv2v

.PHONY: synth-coproc-block
synth-coproc-block:
	@: $(shell mkdir -p $(BLOCK_DIR)/WORK $(BLOCK_DIR)/reports)$(file > $(BLOCK_WRAP),$(BLOCK_WRAP_$(BLOCK)))
	$(SV2V) --define=SYNTHESIS $(BLOCK_SV2V_DEFINES_$(BLOCK)) -I$(COPROC_CC_DIR)/include -I$(COPROC_AXI_DIR)/include \
		$(BLOCK_SRCS_$(BLOCK)) $(BLOCK_WRAP) --top=$(BLOCK_TOP) -w $(BLOCK_SV2V)
	VLOG_FILES="$(BLOCK_SV2V)" TOP_DESIGN="$(BLOCK_TOP)" PROJ_NAME="$(BLOCK_NAME)" \
	WORK="$(BLOCK_DIR)/WORK" BUILD="$(BLOCK_DIR)" REPORTS="$(BLOCK_DIR)/reports" \
	NETLIST="$(BLOCK_NET)" YOSYS_KEEP_HIER_INST="" YOSYS_REPORT_INSTS="" \
	$(YOSYS) -c $(YOSYS_DIR)/scripts/yosys_synthesis.tcl > $(BLOCK_DIR)/yosys.log 2>&1 \
		|| (tail -30 $(BLOCK_DIR)/yosys.log; exit 1)
	cd $(BLOCK_DIR) && NETLIST="$(BLOCK_NET)" TOP_DESIGN="$(BLOCK_TOP)" \
		BLOCK_PERIOD_NS="$(BLOCK_PERIOD_NS)" \
		$(STA) -no_init -exit $(YOSYS_DIR)/scripts/block_sta.tcl > $(BLOCK_DIR)/sta.rpt 2>&1
	python3 $(YOSYS_DIR)/scripts/block_metrics.py \
		--area $(BLOCK_DIR)/reports/$(BLOCK_NAME)_area.json \
		--check $(BLOCK_DIR)/reports/$(BLOCK_NAME)_synth.rpt \
		--sta $(BLOCK_DIR)/sta.rpt --log $(BLOCK_DIR)/yosys.log --period-ns $(BLOCK_PERIOD_NS) \
		--block $(BLOCK) --rounds-per-cycle $(ROUNDS_PER_CYCLE) \
		--out $(BLOCK_DIR)/metrics.json

# Every synthesizable hw/coproc block, each at its default parameters - the
# CI `synth-coproc` gate (fails if any block fails or reports a CHECK problem).
COPROC_SYNTH_BLOCKS ?= keccak_cvxif keccak_mmio

.PHONY: synth-coproc-all
synth-coproc-all:
	@set -e; for b in $(COPROC_SYNTH_BLOCKS); do \
		$(MAKE) --no-print-directory synth-coproc-block BLOCK=$$b; \
	done

# -----------------------------------------------------------------------------
# Activity-annotated block power (openspec change sha3-cvxif-coprocessor,
# task 5.2, design D8). Needs synth-coproc-block's netlist for the same
# BLOCK/ROUNDS_PER_CYCLE. Steps:
#   1. yosys builds a gate-level simulation model: read_liberty (not -lib)
#      turns each SG13G2 cell's liberty function / ff group into a model. The
#      netlist keeps one instance per cell (no flatten): OpenSTA's read_saif
#      annotates instance pins, so the SAIF must hold <cell>/<pin> scopes,
#      which Verilator's trace keeps even when it inlines the cell modules.
#   2. block_glwrap.py gives that model its RTL struct ports back.
#   3. Verilator runs the block's power workload (tb/tb_<BLOCK>_power-style
#      harness, here hw/coproc/tb/tb_keccak_power.cpp) on it and records SAIF
#      over the workload window; the harness also checks the final state
#      against the C++ reference.
#   4. OpenSTA annotates the netlist from that SAIF (names match, so
#      annotation is direct) and reports power at the typical corner.
#   5. block_power_metrics.py writes power.json (power, annotated fraction,
#      workload, energy per block).
#
#   make power-coproc-block BLOCK=keccak_cvxif ROUNDS_PER_CYCLE=6
#
# POWER_PLUSARGS overrides the workload (e.g. +blocks=64 +block_cycles=155).

POWER_PLUSARGS   ?=
BLOCK_GLSIM      := $(BLOCK_DIR)/$(BLOCK_NAME).glsim.v
BLOCK_GLWRAP     := $(BLOCK_DIR)/$(BLOCK)_gl.sv
BLOCK_GLBUILD    := $(BLOCK_DIR)/glsim_build
BLOCK_SAIF       := $(BLOCK_DIR)/power.saif
BLOCK_POWER_TB_keccak_cvxif := $(COPROC_TB)/tb_keccak_power.cpp
BLOCK_POWER_TOP_keccak_cvxif := $(COPROC_TB)/keccak_cvxif_tb_top.sv
# SAIF scope of the netlist instance: Verilator's TOP, the testbench top,
# the wrapper (i_dut) and the netlist (i_netlist). --trace-underscore keeps
# yosys's _NNNNNN_ nets, which Verilator leaves out of traces by default.
BLOCK_SAIF_SCOPE ?= TOP/keccak_cvxif_tb_top/i_dut/i_netlist

.PHONY: power-coproc-block
power-coproc-block:
	@test -f $(BLOCK_NET) || { echo "power-coproc-block: $(BLOCK_NET) missing - run synth-coproc-block BLOCK=$(BLOCK) ROUNDS_PER_CYCLE=$(ROUNDS_PER_CYCLE) first"; exit 1; }
	$(YOSYS) -q -l $(BLOCK_DIR)/glsim.log -p 'read_liberty -ignore_miss_func $(TECH_CELLS)' \
		-p 'read_verilog $(BLOCK_NET)' -p 'hierarchy -top $(BLOCK_TOP)' \
		-p 'write_verilog -noattr $(BLOCK_GLSIM)'
	python3 $(YOSYS_DIR)/scripts/block_glwrap.py $(BLOCK_GLSIM) $(BLOCK_TOP) $(BLOCK)_gl $(BLOCK_GLWRAP)
	rm -rf $(BLOCK_GLBUILD)
	$(VERILATOR) --cc --exe --build -O1 -Wno-fatal -Wno-lint -Wno-style -Wno-UNOPTFLAT \
		--trace-saif --trace-underscore --timescale 1ps/1ps -DKECCAK_GL -GRoundsPerCycle=$(ROUNDS_PER_CYCLE) \
		+incdir+$(COPROC_CC_DIR)/include \
		-CFLAGS "-O1 -std=c++17 -I$(COPROC_TB)" -MAKEFLAGS "OBJCACHE=" \
		$(COPROC_CVA6_PKGS) $(BLOCK_GLSIM) $(BLOCK_GLWRAP) $(BLOCK_POWER_TOP_$(BLOCK)) \
		--top-module $(notdir $(basename $(BLOCK_POWER_TOP_$(BLOCK)))) \
		--Mdir $(BLOCK_GLBUILD) -o Vpower $(BLOCK_POWER_TB_$(BLOCK)) > $(BLOCK_DIR)/glsim_build.log 2>&1 \
		|| (tail -30 $(BLOCK_DIR)/glsim_build.log; exit 1)
	cd $(BLOCK_DIR) && $(BLOCK_GLBUILD)/Vpower +saif=$(BLOCK_SAIF) \
		+stats=$(BLOCK_DIR)/power_workload.json $(POWER_PLUSARGS)
	cd $(BLOCK_DIR) && NETLIST="$(BLOCK_NET)" TOP_DESIGN="$(BLOCK_TOP)" \
		BLOCK_PERIOD_NS="$(BLOCK_PERIOD_NS)" BLOCK_SAIF="$(BLOCK_SAIF)" \
		BLOCK_SAIF_SCOPE="$(BLOCK_SAIF_SCOPE)" \
		$(STA) -no_init -exit $(YOSYS_DIR)/scripts/block_power.tcl > $(BLOCK_DIR)/power.rpt 2>&1
	python3 $(YOSYS_DIR)/scripts/block_power_metrics.py --power $(BLOCK_DIR)/power.rpt \
		--workload $(BLOCK_DIR)/power_workload.json --block $(BLOCK) \
		--rounds-per-cycle $(ROUNDS_PER_CYCLE) --out $(BLOCK_DIR)/power.json
