#
# Optimization script utilizing 'Lazy Mans Synthesis'
# Requires the library of 6-input records (src/rec6Lib...)
# https://people.eecs.berkeley.edu/~alanmi/publications/2012/iccad12_lms.pdf

print_stats

# strash can fix some yosys-convertion edge-cases, good idea to run first
strash

alias b balance
alias rw rewrite
alias rwz rewrite -z
alias rf refactor
alias rfz refactor -z
alias rs resub
alias rsz resub -z
alias resyn2      "b; rw; rf; b; rw; rwz; b; rfz; rwz; b"

# resyn2

rec_start3 {REC_AIG}

# main optimization iteration:
alias &opt_iter "&st; &if -y -K 6; &syn2; &b; &st; &dch -x; &if -K 6;"
# &if -y -K 6; &syn2; &if -K 6, see LMS paper
# &dc2 AIG rewriting (greedy minimization)
# &b   balance structure for depth
# &st  structural hashing
# &dc  compute structural choices
# &nf  select choice and map to tech
# &ps  print statistics
# mapping iteration
alias &map_iter "&st; &dch -x; &nf {D};"

# initial mapping iteration
&get -n
echo "Initial network:"
&ps
echo "High effort delay optimization..."
&opt_iter; &opt_iter; &ps;
&opt_iter; &opt_iter; &ps;
&opt_iter; &opt_iter; &ps;
&opt_iter; &opt_iter; &ps;
&put

# according to https://people.eecs.berkeley.edu/~alanmi/abc/
# it can take up to 10-ish iterations for convergence
# in my experience it seems to get 99% there after 5-6 with a lower runtime
&get -n
echo "Opt+mapping Iterations..."
&opt_iter; &map_iter;
&opt_iter; &map_iter;
&opt_iter; &map_iter;
&opt_iter; &map_iter;
&opt_iter; &map_iter;
&put
 
 
topo
stime

# NOTE: a BLIF save/reload used to sit here ("currently there is a bug in
# buffer making this necessary"), working around a bug in the 2022-era ABC
# bundled with the old yosys fork. It was written as
#   write_blif "{tmpdir}/tmp.blif"; read_lib -w "{TECH_CELLS}"; read_blif ...
# and relied on a fork-only feature: that yosys substituted {tmpdir} inside a
# user ABC script. Upstream yosys never does - it emits `source <path>` and
# lets ABC read this file verbatim, so {tmpdir} would reach ABC as a literal
# directory name that does not exist. Removed with the v0.69 upgrade
# (openspec/changes/upgrade-yosys-upstream, design D3 option 1); this file's
# other placeholders ({D}, {REC_AIG}, {TECH_CELLS}) are substituted by
# processAbcScript in yosys_common.tcl before ABC ever sees them, so they are
# unaffected. The re-read of the liberty was only needed to restore state
# after the reload, and the library from yosys's own preamble is still loaded.
# If cell buffering or sizing below ever looks wrong, this is the first thing
# to suspect.

echo "buffering for delay and fanout..."
buffer -p
echo "resizing cells..."
upsize {D}
dnsize {D}
upsize {D}
dnsize {D}

echo "Final timing:"
stime
